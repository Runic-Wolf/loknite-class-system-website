{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loknite-class-system-website",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "LokniteVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LokniteVault"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
